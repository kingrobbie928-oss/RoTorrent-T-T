
/* RoTorrent — light theme. Generated by build_theme.py — edit the template, not this file.
   Object names below are what you set with setObjectName() in the C++ UI code. */

* { font-family: "Nunito Sans"; outline: 0; }   /* base size (13px) is set on the application font, not here: a font-size on * would override every setFont() in code */
QMainWindow, QDialog { background: #f4f4f6; color: #17171a; }
QWidget#central { background: #f4f4f6; }
QLabel { background: transparent; color: #17171a; }
QToolTip { background: #ececef; color: #17171a; border: 1px solid #e3e3e8; border-radius: 0px; padding: 1px; font-size: 12px; }   /* square + compact. Qt applies one padding value to all four sides of a tooltip, so 1px keeps it tight vertically while leaving ~5px at the sides */

/* ================= MENU BAR ================= */
QWidget#menuWrap { background: #ffffff; }
QFrame#hairline { background: #e3e3e8; border: 0; }
QMenuBar { background: transparent; color: #6b6b74; border: 0; min-height: 0px; padding: 0; font-size: 12.5px; spacing: 2px; }
QMenuBar::item { background: transparent; color: #6b6b74; padding: 5px 10px; border-radius: 6px; margin: 8px 0; }   /* 28px pill centred in the 44px row (was 40px, nearly touching the top and bottom edges) */
QMenuBar::item:selected, QMenuBar::item:pressed { background: #ececef; color: #17171a; }
QMenu { background: #ffffff; color: #17171a; border: 1px solid #e3e3e8; border-radius: 9px; padding: 4px; font-size: 12.5px; }
QMenu::item { padding: 7px 10px 7px 8px; min-width: 132px; border-radius: 6px; background: transparent; }   /* row = 12px inset | 16px icon | 10px gap | label ... shortcut | 12px inset */
QMenu::icon { margin-left: 6px; margin-right: 8px; }
QMenu::item:selected { background: #ececef; color: #17171a; }
QMenu::item:disabled { color: #a4a4ad; }
QMenu::separator { height: 1px; background: #e3e3e8; margin: 4px 2px; }
QMenu::indicator { width: 13px; height: 13px; left: 10px; }
QMenu::indicator:checked { image: url("@ICONS/ck_accent.svg"); }
QMenu::right-arrow { image: url("@ICONS/chev_right.svg"); width: 10px; height: 10px; margin-right: 6px; }
/* menus that contain checkable items: the icon area is 34px = [checkbox 13px | gap | glyph 16px] so the box and the logo sit side by side (Qt hides its own indicator when an item has an icon) */
QMenu[checks="true"] { icon-size: 34px; }
QMenu[checks="true"]::item { icon-size: 34px; padding: 0px 10px 0px 6px; }
QMenu[checks="true"]::icon { margin-left: 0px; margin-right: 6px; }

/* Log tab (bottom panel) */
QPushButton#logChip { background: transparent; color: #a4a4ad; border: 1px solid #e3e3e8; border-radius: 6px; padding: 0 10px; min-height: 24px; font-size: 11.5px; font-weight: 600; }
QPushButton#logChip:hover { color: #17171a; background: #f7f7f9; }
QPushButton#logChip:checked { color: #17171a; background: #ececef; }
QTextEdit#logText { background: transparent; color: #17171a; border: 0; font-size: 12px; selection-background-color: #ececef; selection-color: #17171a; }

/* dialogs (frameless, same chrome as the main window) */
QDialog#appDialog { background: #ffffff; border: 1px solid #e3e3e8; }
QWidget#dlgHead { background: #ffffff; }
QLabel#dlgTitle { color: #17171a; font-size: 13px; font-weight: 600; }
QLabel#dlgHeading { color: #6b6b74; font-size: 10.5px; font-weight: 600; }
QLabel#dlgKey { color: #6b6b74; font-size: 12.5px; }
QLabel#dlgVal { color: #17171a; font-size: 12.5px; font-weight: 600; }
QLabel#dlgBodyText { color: #6b6b74; font-size: 12.5px; }
QLabel#dlgName { color: #17171a; font-size: 17px; font-weight: 700; }
QPushButton#dlgBtn { background: transparent; color: #e0242c; border: 1px solid #e0242c; border-radius: 8px; padding: 0 18px; min-height: 30px; font-weight: 600; font-size: 12.5px; }
QPushButton#dlgBtn:hover { background: #e0242c; color: #ffffff; }

/* Details-panel tables (Trackers, Peers, HTTP Sources, Content) */
QTableWidget#dTable, QTreeWidget#dTable { background: transparent; border: 0; outline: 0; color: #17171a; font-size: 12.5px; selection-background-color: #ececef; selection-color: #17171a; }
QTableWidget#dTable::item, QTreeWidget#dTable::item { background: transparent; padding: 0 6px; border-bottom: 1px solid #e3e3e8; }
QTableWidget#dTable::item:hover, QTreeWidget#dTable::item:hover { background: #ffffff; }
QTableWidget#dTable::item:selected, QTreeWidget#dTable::item:selected { background: #ececef; color: #17171a; }
QTableWidget#dTable QHeaderView, QTreeWidget#dTable QHeaderView { background: transparent; border: 0; }
QTableWidget#dTable QHeaderView::section, QTreeWidget#dTable QHeaderView::section { background: transparent; color: #6b6b74; padding: 8px 10px; border: 0; border-bottom: 1px solid #e3e3e8; font-size: 10.5px; font-weight: 600; }
QTreeWidget#dTable::indicator { width: 14px; height: 14px; }
QTreeWidget#dTable::indicator:unchecked { image: url("@ICONS/cb_off.svg"); }
QTreeWidget#dTable::indicator:checked { image: url("@ICONS/cb_on.svg"); }
QTreeWidget#dTable::indicator:indeterminate { image: url("@ICONS/cb_part.svg"); }
QTreeWidget#dTable::branch { background: transparent; }
QLabel#dHeading { color: #a4a4ad; }
QPushButton#dBtn { background: #ececef; color: #17171a; border: 1px solid #e3e3e8; border-radius: 8px; padding: 0 14px; font-size: 12px; font-weight: 600; }
QPushButton#dBtn:hover { border-color: #6b6b74; }
QPushButton#dBtn:pressed { background: #f7f7f9; }
/* ===================== forms: layouts loaded from qBittorrent's .ui files (embedded root = QDialog#roUi) ===================== */
QDialog#roUi { background: #ffffff; }
QDialog#roUi QLabel { color: #17171a; background: transparent; }
QDialog#roUi QLabel:disabled, QDialog#roUi QCheckBox:disabled, QDialog#roUi QRadioButton:disabled, QDialog#roUi QGroupBox:disabled { color: #a4a4ad; }
QDialog#roUi QScrollArea, QDialog#roUi QStackedWidget { background: transparent; border: 0; }
QDialog#roUi QScrollArea > QWidget > QWidget { background: transparent; }
QDialog#roUi QGroupBox { background: transparent; border: 1px solid #e3e3e8; border-radius: 10px; margin-top: 14px; padding: 16px 10px 8px 10px; color: #17171a; font-weight: 600; }
QDialog#roUi QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 12px; padding: 0 6px; color: #6b6b74; }
QDialog#roUi QGroupBox::indicator { width: 16px; height: 16px; }
QDialog#roUi QGroupBox::indicator:unchecked { image: url("@ICONS/cb_off.svg"); }
QDialog#roUi QGroupBox::indicator:checked { image: url("@ICONS/cb_on.svg"); }
QDialog#roUi QCheckBox, QDialog#roUi QRadioButton { color: #17171a; background: transparent; spacing: 9px; }
QDialog#roUi QCheckBox::indicator, QDialog#roUi QRadioButton::indicator { width: 16px; height: 16px; }
QDialog#roUi QCheckBox::indicator:unchecked { image: url("@ICONS/cb_off.svg"); }
QDialog#roUi QCheckBox::indicator:unchecked:hover { image: url("@ICONS/cb_off_hover.svg"); }
QDialog#roUi QCheckBox::indicator:checked { image: url("@ICONS/cb_on.svg"); }
QDialog#roUi QCheckBox::indicator:checked:hover { image: url("@ICONS/cb_on_hover.svg"); }
QDialog#roUi QCheckBox::indicator:indeterminate { image: url("@ICONS/cb_part.svg"); }
QDialog#roUi QCheckBox::indicator:unchecked:disabled { image: url("@ICONS/cb_dis_off.svg"); }
QDialog#roUi QCheckBox::indicator:checked:disabled { image: url("@ICONS/cb_dis_on.svg"); }
QDialog#roUi QRadioButton::indicator:unchecked { image: url("@ICONS/rb_off.svg"); }
QDialog#roUi QRadioButton::indicator:unchecked:hover { image: url("@ICONS/rb_off_hover.svg"); }
QDialog#roUi QRadioButton::indicator:checked { image: url("@ICONS/rb_on.svg"); }
QDialog#roUi QRadioButton::indicator:checked:hover { image: url("@ICONS/rb_on_hover.svg"); }
QDialog#roUi QRadioButton::indicator:unchecked:disabled { image: url("@ICONS/rb_dis_off.svg"); }
QDialog#roUi QRadioButton::indicator:checked:disabled { image: url("@ICONS/rb_dis_on.svg"); }
QDialog#roUi QLineEdit, QDialog#roUi QAbstractSpinBox, QDialog#roUi QComboBox, QDialog#roUi QDateTimeEdit { background: #f7f7f9; color: #17171a; border: 1px solid #e3e3e8; border-radius: 8px; padding: 5px 10px; min-height: 20px; selection-background-color: #ececef; selection-color: #17171a; }
QDialog#roUi QLineEdit:focus, QDialog#roUi QAbstractSpinBox:focus, QDialog#roUi QComboBox:focus, QDialog#roUi QComboBox:on { border-color: #3a3a3f; }
QDialog#roUi QLineEdit:disabled, QDialog#roUi QAbstractSpinBox:disabled, QDialog#roUi QComboBox:disabled { background: transparent; color: #a4a4ad; border-color: #e3e3e8; }
QDialog#roUi QLineEdit:read-only { color: #6b6b74; }
/* number fields: a clean [ value  − | + ] stepper instead of two tiny stacked chevrons */
QDialog#roUi QAbstractSpinBox { padding-right: 4px; }   /* Qt already reserves room for the stepper buttons; extra padding clipped the text */
QDialog#roUi QAbstractSpinBox::up-button, QDialog#roUi QAbstractSpinBox::down-button { subcontrol-origin: border; subcontrol-position: center right; width: 26px; height: 24px; border: 0; border-radius: 6px; background: transparent; }
QDialog#roUi QAbstractSpinBox::up-button { margin-right: 4px; }
QDialog#roUi QAbstractSpinBox::down-button { margin-right: 33px; }
QDialog#roUi QAbstractSpinBox::up-button:hover, QDialog#roUi QAbstractSpinBox::down-button:hover { background: #ececef; }
QDialog#roUi QAbstractSpinBox::up-button:pressed, QDialog#roUi QAbstractSpinBox::down-button:pressed { background: #e3e3e8; }
QDialog#roUi QAbstractSpinBox::up-arrow { image: url("@ICONS/step_plus_muted.svg"); width: 12px; height: 12px; }
QDialog#roUi QAbstractSpinBox::down-arrow { image: url("@ICONS/minus_muted.svg"); width: 12px; height: 12px; }
QDialog#roUi QAbstractSpinBox::up-arrow:hover, QDialog#roUi QAbstractSpinBox::down-arrow:hover { width: 12px; height: 12px; }
QDialog#roUi QAbstractSpinBox::up-arrow:disabled, QDialog#roUi QAbstractSpinBox::up-arrow:off { image: url("@ICONS/step_plus_faint.svg"); }
QDialog#roUi QAbstractSpinBox::down-arrow:disabled, QDialog#roUi QAbstractSpinBox::down-arrow:off { image: url("@ICONS/minus_faint.svg"); }
QDialog#roUi QComboBox { padding-right: 26px; }
QDialog#roUi QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 26px; border: 0; background: transparent; }
QDialog#roUi QComboBox::down-arrow { image: url("@ICONS/chev_muted.svg"); width: 10px; height: 10px; }
QDialog#roUi QComboBox QAbstractItemView { background: #ffffff; color: #17171a; border: 1px solid #e3e3e8; border-radius: 8px; padding: 4px; outline: 0; selection-background-color: #ececef; selection-color: #17171a; }
QDialog#roUi QPushButton { background: #ececef; color: #17171a; border: 1px solid #e3e3e8; border-radius: 8px; padding: 0 16px; min-height: 30px; font-weight: 600; }
QDialog#roUi QPushButton:hover { border-color: #6b6b74; }
QDialog#roUi QPushButton:pressed { background: #f7f7f9; }
QDialog#roUi QPushButton:disabled { background: transparent; color: #a4a4ad; }
QDialog#roUi QPushButton[primary="true"] { background: #e0242c; border-color: #e0242c; color: #ffffff; }
QDialog#roUi QPushButton[primary="true"]:hover { border-color: #17171a; }
QDialog#roUi QPushButton[primary="true"]:disabled { background: transparent; color: #a4a4ad; border-color: #e3e3e8; }
QDialog#roUi QToolButton { background: transparent; color: #17171a; border: 1px solid transparent; border-radius: 8px; padding: 5px; }
QDialog#roUi QToolButton:hover { background: #ececef; }
QDialog#roUi QToolButton:disabled { color: #a4a4ad; }
QDialog#roUi QTabWidget::pane { border: 1px solid #e3e3e8; border-radius: 10px; top: -1px; background: transparent; }
QDialog#roUi QTabBar { background: transparent; }
QDialog#roUi QTabBar::tab { background: transparent; color: #6b6b74; padding: 8px 14px; margin-right: 2px; border: 0; border-bottom: 2px solid transparent; }
QDialog#roUi QTabBar::tab:hover { color: #17171a; }
QDialog#roUi QTabBar::tab:selected { color: #e0242c; border-bottom: 2px solid #e0242c; font-weight: 600; }
QDialog#roUi QListWidget#tabSelection { background: transparent; border: 0; outline: 0; padding: 4px 12px 4px 0px; }   /* 12px of air each side of the pill: dialog edge on the left, divider on the right */
QDialog#roUi QListWidget#tabSelection::item { color: #6b6b74; padding: 0 10px; margin: 1px 0; border-radius: 8px; }
QDialog#roUi QListWidget#tabSelection::item:hover { background: #f7f7f9; color: #17171a; }
QDialog#roUi QListWidget#tabSelection::item:selected { background: #ececef; color: #17171a; }
QDialog#roUi QListView, QDialog#roUi QTreeView, QDialog#roUi QTableView, QDialog#roUi QTextEdit, QDialog#roUi QTextBrowser, QDialog#roUi QPlainTextEdit { background: #f7f7f9; color: #17171a; border: 1px solid #e3e3e8; border-radius: 8px; selection-background-color: #ececef; selection-color: #17171a; outline: 0; }
QDialog#roUi QTextEdit, QDialog#roUi QTextBrowser, QDialog#roUi QPlainTextEdit { padding: 7px 10px; }
QDialog#roUi QListView, QDialog#roUi QTreeView, QDialog#roUi QTableView { alternate-background-color: #ffffff; }
QDialog#roUi QListView::item, QDialog#roUi QTreeView::item { padding: 4px 6px; background: transparent; }
QDialog#roUi QListView::item:selected, QDialog#roUi QTreeView::item:selected, QDialog#roUi QTableView::item:selected { background: #ececef; color: #17171a; }
QDialog#roUi QHeaderView { background: transparent; border: 0; }
QDialog#roUi QHeaderView::section { background: #f7f7f9; color: #6b6b74; padding: 7px 10px; border: 0; border-bottom: 1px solid #e3e3e8; font-size: 10.5px; font-weight: 600; text-align: left; }
QDialog#roUi QHeaderView::section:hover { color: #17171a; }
QDialog#roUi QProgressBar { background: #f7f7f9; border: 1px solid #e3e3e8; border-radius: 9px; min-height: 18px; max-height: 18px; text-align: center; color: #6b6b74; font-size: 11px; font-weight: 600; }
QDialog#roUi QProgressBar::chunk { background: #e0242c; border-radius: 8px; margin: 1px; }
QDialog#roUi QSlider::groove:horizontal { height: 4px; background: #ececef; border-radius: 2px; }
QDialog#roUi QSlider::handle:horizontal { width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; background: #e0242c; }
QDialog#roUi QSplitter::handle { background: #e3e3e8; }
QDialog#roUi QFrame[frameShape="4"], QDialog#roUi QFrame[frameShape="5"] { color: #e3e3e8; background: #e3e3e8; border: 0; max-height: 1px; }
QDialog#roUi QFrame[frameShape="5"] { max-height: 16777215px; max-width: 1px; }
QDialog#roUi QDialogButtonBox { background: transparent; }
/* drop zone (Torrent Creator) */
QDialog#roUi QFrame#dropZone { background: transparent; border: 2px dashed #e3e3e8; border-radius: 12px; }
QDialog#roUi QFrame#dropZone[drag="true"] { border-color: #e0242c; background: rgba(224,36,44,20); }
QDialog#roUi QLabel#dropTitle { color: #17171a; font-size: 13px; font-weight: 600; }
QDialog#roUi QLabel#dropSub { color: #a4a4ad; font-size: 11.5px; }
/* Options > Advanced (rebuilt as two cards of rows) */
QDialog#roUi QScrollArea#advScroll, QDialog#roUi QWidget#advHost { background: transparent; border: 0; }
QDialog#roUi QLabel#advHeading { color: #6b6b74; font-size: 10.5px; font-weight: 600; }
QDialog#roUi QFrame#advCard { background: transparent; border: 1px solid #e3e3e8; border-radius: 10px; }
QDialog#roUi QWidget#advRow { background: transparent; }
QDialog#roUi QFrame#advSep { background: #e3e3e8; border: 0; }

/* ================= TOOLBAR ================= */
QFrame#mainToolbar { background: #ffffff; border: 0; border-bottom: 1px solid #e3e3e8; }
QWidget#toolRow { background: transparent; }
QFrame#tbSep { background: #e3e3e8; border: 0; min-width: 1px; max-width: 1px; }
QToolButton#tbIcon { background: transparent; border: 0; border-radius: 8px; padding: 0; }
QToolButton#tbIcon:hover { background: #ececef; }
QToolButton#tbIcon[danger="true"]:hover { background: #a8182a; }   /* delete: deep crimson, clearly darker than the bright accent red of Add torrent / magnet link */

/* window controls: Windows-style — flat, full-height, edge-to-edge rectangles (no rounded chip) */
QToolButton#capBtn { background: transparent; border: 0; border-radius: 0; padding: 0; margin: 0; }
QToolButton#capBtn:hover { background: #ececef; }
QToolButton#capBtn:pressed { background: #e3e3e8; }
QToolButton#capBtn[danger="true"]:hover, QToolButton#capBtn[danger="true"]:pressed { background: #e0242c; }

QLineEdit#searchBox { background: #f7f7f9; color: #17171a; border: 1px solid #e3e3e8; border-radius: 8px; padding: 0 12px 0 32px; font-size: 13px; selection-background-color: #ececef; selection-color: #17171a; placeholder-text-color: #a4a4ad; }
QLineEdit#searchBox:focus { border-color: #3a3a3f; }

QPushButton#addBtn, QPushButton#linkBtn { background: transparent; color: #e0242c; border: 1.5px solid #e0242c; border-radius: 8px; padding: 0 12px; font-size: 12.5px; font-weight: 600; }
QPushButton#linkBtn { padding: 0 9px; }
QPushButton#addBtn:hover, QPushButton#linkBtn:hover { background: #e0242c; color: #ffffff; }
QPushButton#addBtn:pressed, QPushButton#linkBtn:pressed { background: #e0242c; color: #ffffff; padding-top: 1px; }

QCheckBox#themeToggle, QCheckBox#vibrantToggle { spacing: 0; background: transparent; }
QCheckBox#themeToggle::indicator, QCheckBox#vibrantToggle::indicator { width: 40px; height: 20px; }
QCheckBox#themeToggle::indicator:unchecked   { image: url("@ICONS/toggle_theme_dark.svg"); }
QCheckBox#themeToggle::indicator:checked     { image: url("@ICONS/toggle_theme_light.svg"); }
QCheckBox#vibrantToggle::indicator:unchecked { image: url("@ICONS/toggle_vibrant_off.svg"); }
QCheckBox#vibrantToggle::indicator:checked   { image: url("@ICONS/toggle_vibrant_on.svg"); }

/* ================= SIDEBAR ================= */
QFrame#sidebar { background: #ffffff; border: 0; border-right: 1px solid #e3e3e8; }
QTreeWidget#sideTree { background: transparent; border: 0; padding: 14px 0px 14px 10px; show-decoration-selected: 0; }
QTreeWidget#sideTree::item { background: transparent; }   /* rows are painted by SideDelegate */
QTreeWidget#sideTree::branch { background: transparent; image: none; border-image: none; }
QFrame#graphBox { background: #f7f7f9; border: 0; border-top: 1px solid #e3e3e8; border-top-left-radius: 12px; border-top-right-radius: 12px; }
QFrame#graphBox QLabel { font-size: 11px; }
QLabel#graphKey { color: #6b6b74; }
QLabel#graphVal { color: #17171a; }
QSplitter::handle { background: #e3e3e8; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: #e0242c; }

/* ================= TORRENT TABLE ================= */
QTableView#torrentTable { background: #f4f4f6; color: #17171a; border: 0; gridline-color: transparent; selection-background-color: transparent; selection-color: #17171a; }
QTableView#torrentTable QTableCornerButton::section { background: #f4f4f6; border: 0; }
QTableView#torrentTable QHeaderView { background: #f4f4f6; border: 0; }
QTableView#torrentTable QHeaderView::section { background: #f4f4f6; color: #6b6b74; border: 0; border-bottom: 1px solid #e3e3e8; padding: 12px 16px 9px 16px; font-size: 10.5px; font-weight: 600; text-align: left; }
QTableView#torrentTable QHeaderView::section:hover { color: #17171a; }
QTableView#torrentTable QHeaderView::down-arrow, QTableView#torrentTable QHeaderView::up-arrow { width: 9px; height: 9px; }
QTableView#torrentTable QHeaderView::down-arrow { image: url("@ICONS/chev_muted.svg"); }
QTableView#torrentTable QHeaderView::up-arrow   { image: url("@ICONS/chev_up_muted.svg"); }

/* ================= DETAILS PANEL ================= */
QFrame#detailPanel { background: #ffffff; border: 0; border-top: 1px solid #e3e3e8; }
QFrame#detailTabsRow { background: transparent; border: 0; border-bottom: 1px solid #e3e3e8; }
QPushButton#detailTab { background: transparent; color: #6b6b74; padding: 9px 13px; margin: 0; border: 0; border-bottom: 2px solid transparent; border-radius: 0; font-size: 12px; text-align: left; }
QPushButton#detailTab:hover { color: #e0242c; }
QPushButton#detailTab[active="true"] { color: #e0242c; border-bottom: 2px solid #e0242c; font-weight: 600; }
QToolButton#detailToggle { background: transparent; border: 0; border-radius: 7px; padding: 8px; }
QToolButton#detailToggle:hover { background: #f7f7f9; }
QScrollArea#detailScroll { background: transparent; border: 0; }
QScrollArea#detailScroll > QWidget > QWidget { background: transparent; }
QLabel#dName  { font-size: 13px; font-weight: 600; }
QLabel#dLabel { font-size: 10px; color: #a4a4ad; font-weight: 400; }
QLabel#dValue { font-size: 13.5px; color: #17171a; }
QLabel#dEmpty { font-size: 12.5px; color: #a4a4ad; }
QLabel#dBadge { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 99px; }

/* status badges (QLabel[status="..."]) — same tints as .badge.* */
QLabel[status="dl"] { background: rgba(31,168,99,26);   color: #1fa863; }
QLabel[status="sd"] { background: rgba(47,127,224,26);   color: #2f7fe0; }
QLabel[status="pa"] { background: #ececef; color: #6b6b74; }
QLabel[status="qu"] { background: rgba(139,92,246,26); color: #8b5cf6; }
QLabel[status="ck"] { background: rgba(201,138,14,26);  color: #c98a0e; }
QLabel[status="st"] { background: rgba(138,138,146,26);  color: #8a8a92; }
QLabel[status="er"], QLabel[status="mf"] { background: rgba(224,36,44,20); color: #e0242c; }
QLabel[status="fn"] { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #146d40, stop:1 #0b3b23); color: #ffffff; }

/* ================= STATUS BAR ================= */
QFrame#statusBar { background: #ffffff; color: #6b6b74; border: 0; border-top: 1px solid #e3e3e8; font-size: 11.5px; }
QFrame#statusBar QLabel { color: #6b6b74; font-size: 11.5px; background: transparent; }
QFrame#statusSep { background: #e3e3e8; max-width: 1px; min-width: 1px; max-height: 12px; min-height: 12px; }

/* ================= SCROLLBARS ================= */
QScrollBar:vertical   { background: transparent; width: 10px;  margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:vertical   { background: #ececef; min-height: 24px; border-radius: 3px; margin: 0 2px; }
QScrollBar::handle:horizontal { background: #ececef; min-width: 24px;  border-radius: 3px; margin: 2px 0; }
QScrollBar::handle:hover { background: #a4a4ad; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: none; border: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QAbstractScrollArea::corner { background: transparent; }
